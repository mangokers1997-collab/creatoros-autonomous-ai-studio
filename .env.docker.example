# Copy this file to .env. Fill in secrets before first startup.
CREATOROS_ENV=production
CREATOROS_HOST=0.0.0.0
CREATOROS_PORT=8000

# Required once to create the first owner. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CREATOROS_SETUP_TOKEN=

# Set true only when HTTPS is correctly configured at the reverse proxy.
CREATOROS_COOKIE_SECURE=false
CREATOROS_SESSION_DAYS=7

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREATOROS_FERNET_KEY=
# Generate a separate random value:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CREATOROS_OAUTH_STATE_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/oauth/youtube/callback

# Keep disabled until the OAuth connection and a manual test upload have succeeded.
CREATOROS_PUBLISH_WORKER_ENABLED=false
CREATOROS_PUBLISH_POLL_SECONDS=15
