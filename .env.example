CREATOROS_ENV=development
CREATOROS_HOST=127.0.0.1
CREATOROS_PORT=8000
CREATOROS_DATABASE_URL=sqlite:///./creatoros.db
CREATOROS_REQUIRE_APPROVAL=true

# Google Cloud Console OAuth 2.0 Web client (never commit real secrets)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/oauth/youtube/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREATOROS_FERNET_KEY=

# Generate a random string with at least 32 characters. Keep it stable and secret.
CREATOROS_OAUTH_STATE_SECRET=
# Encrypted OAuth tokens are stored here; keep this directory private and backed up.
CREATOROS_TOKEN_DIR=./secure_tokens

# Scheduled YouTube worker: opt in only after OAuth and a real test upload.
CREATOROS_PUBLISH_WORKER_ENABLED=false
CREATOROS_PUBLISH_POLL_SECONDS=15

# Authentication / session hardening
CREATOROS_SESSION_DAYS=7
# Set true behind HTTPS in production; false only for local HTTP development.
CREATOROS_COOKIE_SECURE=false
